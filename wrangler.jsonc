{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-spawn",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "SPAWN_TIMEZONE": "America/Mexico_City",
    "SPAWN_CONFIG_VERSION": "1"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "SPAWN_DB",
      "database_name": "project-spawn",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
