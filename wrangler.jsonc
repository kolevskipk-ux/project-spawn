{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-spawn",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "SPAWN_TIMEZONE": "America/Mexico_City",
    "SPAWN_CONFIG_VERSION": "5.1",
    "PUBLIC_BASE_URL": "https://project-spawn.phil-kolevski.workers.dev"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "7251001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "7251002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MANUAL_RATE_LIMIT",
      "namespace_id": "7251003",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "SPAWN_DB",
      "database_name": "project-spawn",
      "database_id": "8fd44e8d-9ffc-4f9b-8c2c-f6ba1a9827aa",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
