{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garfield-customers-production",
  "main": "src/customer.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "customers.aztlan-eng.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CUSTOMER_ACCESS_ISSUER": "https://hidden-shadow-9100.cloudflareaccess.com",
    "CUSTOMER_ACCESS_AUD": "968bc7bb85517fcf1f7a78da46f69b4a7f932aa688854a5c955a3c39c80c0b3d",
    "CUSTOMER_ENVIRONMENT": "Live inventory",
    "CUSTOMER_INVENTORY_MODE": "source",
    "CUSTOMER_DATA_KIND": "published",
    "CUSTOMER_MEMBERSHIP_MODE": "new_accounts",
    "DISCORD_GUILD_ID": "1537592665535942709",
    "DISCORD_FREE_ACCESS_ENABLED": "true",
    "DISCORD_ROLE_SYNC_ENABLED": "false",
    "DISCORD_REDIRECT_URI": "https://customers.aztlan-eng.com/app/discord/callback",
    "CUSTOMER_PUBLIC_URL": "https://customers.aztlan-eng.com",
    "CUSTOMER_LEGAL_PUBLISHED": "true",
    "CUSTOMER_TERMS_VERSION": "PP-TERMS-0.3.6",
    "CUSTOMER_TERMS_EFFECTIVE_DATE": "2026-09-09",
    "CUSTOMER_TERMS_REQUIRED_FROM": "2026-09-10T00:47:12.000Z",
    "CUSTOMER_OPERATOR_NAME": "Aztlan Engineering",
    "CUSTOMER_OPERATOR_ADDRESS": "Sabadonas 53 PA, La Concordia, Naucalpan, Edo Mex, 53126",
    "CUSTOMER_PRIVACY_EMAIL": "sales@aztlan-eng.com",
    "DISCORD_APPLICATION_ID": "1547374053248204840",
    "DISCORD_PUBLIC_KEY": "7a39b11d9eaadeaa26c47b60ae8a01a1a07556becf9901f73efce0c5a1223279",
    "DISCORD_INVENTORY_ROLE_ID": "1547379339446976642",
    "DISCORD_REQUIRED_ROLE_ID": "1547379340566724709"
  },
  "d1_databases": [
    {
      "binding": "CUSTOMER_DB",
      "database_name": "garfield-customers-production",
      "database_id": "a7730486-5f12-4d22-ad81-f4cfd1c917d3",
      "migrations_dir": "customer-migrations"
    }
  ],
  "triggers": {
    "crons": []
  },
  "services": [
    {
      "binding": "CUSTOMER_SOURCE",
      "service": "garfield-customer-source-production"
    }
  ]
}
