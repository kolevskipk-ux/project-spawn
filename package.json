{
  "name": "project-spawn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply SPAWN_DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply SPAWN_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SPAWN_DB --remote",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  },
  "dependencies": {
    "jose": "6.1.3"
  }
}
